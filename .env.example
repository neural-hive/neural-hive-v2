# ===== Neural Hive Configuration (example) =====
# Copy to .env and fill in values. Never commit .env.

# --- Chain / RPC ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
NETWORK=ganache

# --- Accounts (DISPOSABLE local dev keys only) ---
PRIVATE_KEY_1=
PRIVATE_KEY_2=
ADDRESS_1=
ADDRESS_2=

# --- Protocol deployment ---
HIVE_TOKEN_ADDRESS=
CAPABILITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
STAKING_SETTLEMENT_ADDRESS=
TASK_COORDINATOR_ADDRESS=
HIVE_SNOWBALL_ADDRESS=
MOCK_TELEPORTER_ADDRESS=

# --- Coordinator / relayer ---
COORDINATOR_API_URL=http://127.0.0.1:9200
RELAYER_URL=http://127.0.0.1:9300

# --- Mock agents ---
AGENT_1_URL=http://127.0.0.1:9101
AGENT_2_URL=http://127.0.0.1:9102
AGENT_3_URL=http://127.0.0.1:9103

# --- Protocol economics ---
PROTOCOL_FEE_BPS=700
EMBEDDING_DIM=8
AGENT_4_URL=http://127.0.0.1:9104
AGENT_5_URL=http://127.0.0.1:9105

# --- Deployment address note ---
# The *_ADDRESS values above are optional. After truffle migrate --network ganache the Go
# services read the authoritative addresses from contracts/deployments.json, which the migration
# rewrites, so you normally do not need to edit them by hand.

# --- DeepSeek model backend (server-side only) ---
# The API key is read by the Go deepseek-agent only. It is never exposed to the browser,
# never returned through an API response and never committed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# The DeepSeek agent service the coordinator designates as the natural-language answerer.
DEEPSEEK_AGENT_URL=http://127.0.0.1:9107
DEEPSEEK_AGENT_INDEX=6
DEEPSEEK_TIMEOUT_SECONDS=120

# --- Neural Hive Hub (multi-agent orchestrator) ---
# The Hub sits between the existing backend and a pool of independent, capability-tagged DeepSeek
# agents. The pool size and the tag policy are configuration.
HUB_PORT=9500
HIVE_AGENT_COUNT=5
HIVE_AGENT_BASE_PORT=9401
HIVE_AGENT_START_INDEX=100
HUB_AGENT_MODEL=deepseek-flash
HUB_AGGREGATOR_MODEL=deepseek-flash
# HIVE is the number of independent agents a task needs: 1 for simple tasks, more for complex.
HIVE_DEFAULT=1
HIVE_COMPLEX=2
HIVE_MAX=10
HUB_STATE_FILE=logs/hub-state.json
# Optional: full roster override "agent-01:9401:research,analysis;agent-02:9402:coding"
# HIVE_AGENT_ROSTER=
# Optional: per-instance tag override AGENT_1_TAGS=research,analysis

# --- DeepSeek agent roster: capability tags per instance (port = HIVE_AGENT_BASE_PORT + n - 1) ---
AGENT_1_TAGS=research
AGENT_2_TAGS=analysis,research
AGENT_3_TAGS=coding
AGENT_4_TAGS=security,blockchain
AGENT_5_TAGS=planning,reasoning
AGENT_6_TAGS=validation,reasoning
AGENT_7_TAGS=blockchain,security
AGENT_8_TAGS=architecture,planning
AGENT_9_TAGS=summarization,research
AGENT_10_TAGS=data,analysis

# --- HIVE payment (MetaMask) ---
# Every task is paid in HIVE from the user's MetaMask wallet: cost = agents required x price per agent.
HUB_REQUIRE_PAYMENT=true
HIVE_PRICE_PER_AGENT=1
# Treasury that receives the HIVE (defaults to ADDRESS_1, the deployer).
HIVE_TREASURY_ADDRESS=
# Local devnet only: the Hub faucet tops a connected wallet up to this much test HIVE (plus gas).
HIVE_FAUCET_AMOUNT=100
HIVE_QUOTE_TTL_SECONDS=900
# --- Agent registration fee (HIVE): any wallet may register an agent, but it must spend this
# much HIVE (verified on chain) after the live probe passes.
HIVE_REGISTRATION_FEE=5

# --- Hub fee and chat history (configurable) ---
HUB_FEE_PERCENT=2
HUB_HISTORY_LIMIT=8
HUB_PRIVATE_KEY=
AGENT_KEY_SEED=neural-hive-devnet

# --- Per-agent AgentWallet smart contract (one deployed per agent; only the owner can withdraw) ---
AGENT_WALLET_FACTORY_ADDRESS=
